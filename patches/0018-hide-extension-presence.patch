+bool Document::HiddenForScript() const {
+  if (base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserHideExtensionPresence)) {
+    // JithuBrowser: script never learns about extension presence through DOM.
+    // Only report "hidden" while the document is really going away.
+    return !GetFrame() || !GetFrame()->GetPage() ||
+           load_event_progress_ >= kUnloadVisibilityChangeInProgress;
+  }
+  return hidden();
+}
+
+// JithuBrowser: hide extension-injected DOM subtrees from the page.
// This prevents pages from detecting installed extensions through
// document.querySelector or similar DOM probes.
+bool Document::IsExtensionRoot(const Node* node) const {
+  if (!base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserHideExtensionPresence)) {
+    return false;
+  }
+  // Check if this node is an extension-injected root subtree.
+  // We recognize common extension root patterns like "grammarly-root"
+  // and similar extension host container IDs.
+  const char* kExtensionRootIds[] = {"grammarly-root", "extension-root", "adblock-root"};
+  for (const char* id : kExtensionRootIds) {
+    if (node->hasAttribute(v8::String::NewFromUtf8Literal(isolate, "id"))) {
+      v8::Local<v8::Value> id_val;
+      if (node->getAttribute(v8::String::NewFromUtf8Literal(isolate, "id"), id_val)) {
+        v8::String::Utf8Value id_str(isolate, id_val);
+        for (const char* kId : kExtensionRootIds) {
+          if (id_str && strcmp(*id_str, kId) == 0) {
+            return true;
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
