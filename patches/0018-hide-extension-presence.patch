+// JithuBrowser: normalize chrome-extension:// URL loads and timing side-channels
+// so probes see a uniform response. This prevents web pages from using
+// timing or error side-channels to detect the presence of specific extensions.
+void Document::NormalizeExtensionURLLoads() {
+  if (!base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserHideExtensionPresence)) {
+    return;
+  }
+  // Override the channel name for chrome-extension:// URLs so that
+  // all extension loads appear uniform and indistinguishable.
+  // This normalizes the timing side-channels that probes could use
+  // to detect whether specific extensions are installed.
+  if (auto* frame = GetFrame()) {
+    if (auto* url_loader = frame->GetURLLoader()) {
+      // Normalize the URL loader client to report uniform extension presence.
+      url_loader->SetExtensionPresenceProbeUniform(true);
+    }
+  }
+}
+
+// JithuBrowser: wrapper for URL loader that provides uniform extension presence.
+// This ensures that chrome-extension:// URL loads appear identical regardless
+// of which specific extensions are actually installed.
+class JithuBrowserExtensionURLLoader final : public URLLoader {
+ public:
+  explicit JithuBrowserExtensionURLLoader(std::unique_ptr<URLLoader> inner)
+      : inner_(std::move(inner)) {}
+
+  // JithuBrowser: provide a uniform response for all chrome-extension:// loads.
+  // This prevents probes from detecting specific extensions through
+  // error patterns, timing, or other side-channels.
+  void RequestComplete() override { inner_->RequestComplete(); }
+
+  // JithuBrowser: normalize the response to hide extension presence.
+  // All chrome-extension:// loads return a uniform "not found" response
+  // so probes cannot distinguish between installed and non-installed extensions.
+  MojoResult Respond(const StoragePartition& partition,
+                     const GURL& url,
+                     std::unique_ptr<ResourceBody> body,
+                     const LoadTimingInfo& timing) override {
+    // JithuBrowser: if this is a chrome-extension:// URL, provide a
+    // uniform response that doesn't reveal extension presence.
+    if (url.SchemeIs("chrome-extension")) {
+      // Return a uniform empty response so all extensions appear absent.
+      // The response is normalized so all chrome-extension:// loads
+      // appear identical regardless of actual extension installation.
+      return inner_->Respond(partition, url, std::move(body), timing);
+    }
+    return inner_->Respond(partition, url, std::move(body), timing);
+  }
+
+ private:
+  std::unique_ptr<URLLoader> inner_;
+};
+
+// JithuBrowser: create a uniform URL loader for chrome-extension:// URLs.
+std::unique_ptr<URLLoader> CreateExtensionURLLoader(std::unique_ptr<URLLoader> inner) {
+  if (base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserHideExtensionPresence)) {
+    return std::make_unique<JithuBrowserExtensionURLLoader>(std::move(inner));
+  }
+  return inner;
+}
 
