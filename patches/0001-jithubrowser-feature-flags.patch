+namespace jithubrowser::features {
+
+BASE_FEATURE(kJithuBrowserHideVisibility, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserHideFocus, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserHideWindowGeometry, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserHideHistoryLength, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserHideAutomation, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserReduceClientHints, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserProtectKeyboard, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserKeystrokeJitter, base::FEATURE_ENABLED_BY_DEFAULT);
+const base::FeatureParam<int> kJithuBrowserKeystrokeJitterMaxMs{
+    &kJithuBrowserKeystrokeJitter, "max_ms", 30};
+const base::FeatureParam<int> kJithuBrowserKeystrokeDelayMaxMs{
+    &kJithuBrowserKeystrokeJitter, "delay_max_ms", 20};
+
+BASE_FEATURE(kJithuBrowserKeepHiddenTabsActive, base::FEATURE_ENABLED_BY_DEFAULT);
+
+BASE_FEATURE(kJithuBrowserPrivateFindInPage, base::FEATURE_ENABLED_BY_DEFAULT);
+
+BASE_FEATURE(kJithuBrowserSilentTabFullscreenExit,
+             base::FEATURE_ENABLED_BY_DEFAULT);
+
+BASE_FEATURE(kJithuBrowserUpdateCheck, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserSiteSettings, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserFarbleCanvas, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserFarbleWebGL, base::FEATURE_ENABLED_BY_DEFAULT);
+BASE_FEATURE(kJithuBrowserFarbleAudio, base::FEATURE_ENABLED_BY_DEFAULT);
+
+namespace {
+std::atomic<bool> g_protections_suspended{false};
+uint64_t Mix(uint64_t x) {
+  x ^= x >> 33;
+  x *= 0xff51afd7ed558ccdULL;
+  x ^= x >> 33;
+  x *= 0xc4ceb9fe1a85ec53ULL;
+  x ^= x >> 33;
+  return x;
+}
+}  // namespace
+
+void SetProtectionsSuspended(bool suspended) {
+  g_protections_suspended.store(suspended, std::memory_order_relaxed);
+}
+
+bool ProtectionsSuspended() {
+  return g_protections_suspended.load(std::memory_order_relaxed);
+}
+
+bool IsOn(const base::Feature& feature) {
+  return !ProtectionsSuspended() && base::FeatureList::IsEnabled(feature);
+}
+
+uint64_t FarbleSeed() {
+  static const uint64_t seed = base::RandUint64();
+  return seed;
+}
+
+void FarblePixels(uint8_t* data,
+                  size_t row_bytes,
+                  int width,
+                  int height,
+                  bool premultiplied) {
+  // Tiny images are used for feature detection; leave them exact.
+  if (!data || width <= 0 || height <= 0 ||
+      static_cast<int64_t>(width) * height <= 64) {
+    return;
+  }
+  const uint64_t seed = FarbleSeed();
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = data + static_cast<size_t>(y) * row_bytes;
+    for (int x = 0; x < width; ++x) {
+      uint8_t* px = row + static_cast<size_t>(x) * 4;
+      const int alpha = px[3];
+      if (alpha == 0) {
+        continue;
+      }
+      const uint64_t h = Mix(seed ^ (static_cast<uint64_t>(y) << 32 | x));
+      if ((h & 3) != 0) {  // perturb about a quarter of the pixels
+        continue;
+      }
+      for (int c = 0; c < 3; ++c) {
+        const int delta = ((h >> (8 + 2 * c)) & 1) ? 1 : -1;
+        const int limit = premultiplied ? alpha : 255;
+        px[c] = static_cast<uint8_t>(std::clamp(px[c] + delta, 0, limit));
+      }
+    }
+  }
+}
+
+void FarbleAudioSamples(float* data, size_t count) {
+  if (!data) {
+    return;
+  }
+  const uint64_t seed = FarbleSeed();
+  for (size_t i = 0; i < count; ++i) {
+    const uint64_t h = Mix(seed ^ i);
+    const float noise = (static_cast<float>(h & 0xffff) / 32768.0f - 1.0f) * 1e-7f;
+    data[i] *= 1.0f + noise;
+  }
+}
+
+}  // namespace jithubrowser::features
