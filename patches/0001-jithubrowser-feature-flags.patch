+// Copyright 2026 The JithuBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_JITHUBROWSER_FEATURES_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_JITHUBROWSER_FEATURES_H_
+
+#include "base/feature_list.h"
+#include "third_party/blink/public/common/common_export.h"
+
+// JithuBrowser privacy protections. Every protection is enabled by default and
+// can be turned off individually with --disable-features=<FeatureName>, for
+// example --disable-features=JithuBrowserHideVisibility,JithuBrowserHideFocus.
+// (No chrome://flags entries are registered.)
+namespace jithubrowser::features {
+
+// Page Visibility API always reports "visible"; no visibilitychange,
+// visibility-state performance entries, freeze/resume events or wasDiscarded.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserHideVisibility);
+
+// Pages always believe their window is focused: no window blur/focus events,
+// document.hasFocus() stays true, :focus is not lost when switching windows.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserHideFocus);
+
+// Window geometry is not a fingerprint and does not reveal F11 fullscreen:
+// outerWidth/outerHeight follow the viewport, screenX/Y are 0 and the
+// display-mode media query never matches "fullscreen" for browser fullscreen.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserHideWindowGeometry);
+
+// history.length never reveals how many pages were visited in this tab.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserHideHistoryLength);
+
+// navigator.webdriver is always false.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserHideAutomation);
+
+// The User-Agent string and Client Hints look like stock Google Chrome, with
+// high-entropy hints reduced (no model, no exact versions).
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserReduceClientHints);
+
+// The keyboard layout map is standard US, so the user's layout/language
+// cannot be fingerprinted.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserProtectKeyboard);
+
+// Keyboard events are delivered with a small random delay (order preserved)
+// so typing rhythm cannot be used as a biometric fingerprint.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserKeystrokeJitter);
+
+// Maximum keystroke delay in milliseconds for kJithuBrowserKeystrokeJitter.
+BLINK_COMMON_EXPORT extern const base::FeatureParam<int>
+    kJithuBrowserKeystrokeJitterMaxMs;
+
+// Maximum random delay, in milliseconds, before a key event is handed to the page (order preserved), so
+// typing rhythm measured with performance.now() inside a key handler is blurred as well.
+BLINK_COMMON_EXPORT extern const base::FeatureParam<int>
+    kJithuBrowserKeystrokeDelayMaxMs;
+
+// Hidden, minimised and occluded tabs keep painting and are not throttled (they are treated like
+// a tab being screen-captured), so a page cannot tell it is in the background from its timers
+// (setInterval/setTimeout rate) or requestAnimationFrame. Costs CPU/battery for background tabs.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserKeepHiddenTabsActive);
+
+// Find in page does not search inside collapsed or hidden-until-found content (closed <details>,
+// hidden=until-found, content-visibility), so a page cannot plant hidden "canary" text and learn what
+// the user searched for from the beforematch / toggle events that a match would trigger.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserPrivateFindInPage);
+
+// When the user switches away from a tab that is fullscreen on its own request (a video player, an exam
+// page), the window leaves fullscreen as usual but the page is not told: a page that insists on staying
+// fullscreen cannot see that the user left. Fullscreen is restored when the user returns to the tab.
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kJithuBrowserSilentTabFullscreenExit);
+
+// Height of the browser UI (tab strip + toolbar) that the spoofed window
+// geometry reports above the viewport.
+inline constexpr int kJithuBrowserChromeHeight = 85;
+
+}  // namespace jithubrowser::features
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_JITHUBROWSER_FEATURES_H_
