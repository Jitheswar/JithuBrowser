+// JithuBrowser: handle visibility change to pause/resume extension re-check cadence.
+void HTMLWindowProxy::OnVisibilityChange(bool hidden) {
+  if (base::FeatureList::IsEnabled(
+          jithubrowser::features::kJithuBrowserVirtualizeExtensionEnv)) {
+    // When visibility changes (e.g., tab becomes hidden), pause the extension re-check
+    // cadence to avoid unnecessary re-checks while the user is not actively viewing
+    // the page. This also helps protect privacy by reducing timing side-channels.
+    synthetic_dispatch_paused_ = hidden;
+  }
+}
