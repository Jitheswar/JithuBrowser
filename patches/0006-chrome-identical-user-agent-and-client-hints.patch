--- a/components/embedder_support/user_agent_utils.cc
+++ b/components/embedder_support/user_agent_utils.cc
@@ -34,6 +34,7 @@
 #include "net/http/http_util.h"
 #include "third_party/blink/public/common/features.h"
 #include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+#include "third_party/blink/public/common/jithubrowser_features.h"
 
 #if BUILDFLAG(IS_WIN)
 #include <windows.h>
@@ -154,6 +155,16 @@ const std::string& GetWindowsPlatformVersion() {
 }
 #endif  // BUILDFLAG(IS_WIN)
 
+// JithuBrowser: reduce a dotted version ("14.5.1", "6.8.0-45-generic") to its
+// major component ("14.0.0") so OS updates cannot be used for fingerprinting.
+std::string JithuBrowserReduceVersion(const std::string& version,
+                                      const char* suffix) {
+  if (version.empty()) {
+    return version;
+  }
+  return base::StrCat({version.substr(0, version.find('.')), suffix});
+}
+
 const blink::UserAgentBrandList GetUserAgentBrandList(
     const std::string& major_version,
     const std::string& full_version,
@@ -166,10 +177,17 @@ const blink::UserAgentBrandList GetUserAgentBrandList(
 #if !BUILDFLAG(CHROMIUM_BRANDING)
   brand = version_info::GetProductName();
 #endif
+  const bool jithu_reduce = base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserReduceClientHints);
+  if (jithu_reduce) {
+    // JithuBrowser: look exactly like stock Google Chrome so Chrome-only
+    // sites work and the browser blends in with the largest crowd.
+    brand = "Google Chrome";
+  }
 
   std::string brand_version =
       output_version_type == blink::UserAgentBrandVersionType::kFullVersion
-          ? full_version
+          ? (jithu_reduce ? JithuBrowserReduceVersion(major_version, ".0.0.0")
+                          : full_version)
           : major_version;
 
   return GenerateBrandVersionList(major_version_number, brand, brand_version,
@@ -215,7 +233,8 @@ const blink::UserAgentBrandList GetUserAgentBrandFullVersionListInternal(
 // depending on the Reduce User-Agent reduction phase features.
 std::string GetUserAgentInternal() {
   std::string product = GetProductAndVersion();
-  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless)) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless) &&
+      !base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserReduceClientHints)) {
     product.insert(0, "Headless");
   }
 
@@ -697,6 +716,21 @@ blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
   metadata.bitness = GetCpuBitness();
   metadata.wow64 = IsWoW64();
   metadata.platform_version = GetPlatformVersion();
+  if (base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserReduceClientHints)) {
+    // JithuBrowser: high-entropy hints carry no more information than the
+    // reduced User-Agent string: no device model, no exact browser or OS
+    // version, no kernel version on Linux.
+    metadata.full_version = JithuBrowserReduceVersion(
+        std::string(version_info::GetMajorVersionNumber()), ".0.0.0");
+    metadata.model = std::string();
+    metadata.wow64 = false;
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    metadata.platform_version = std::string();
+#else
+    metadata.platform_version =
+        JithuBrowserReduceVersion(metadata.platform_version, ".0.0");
+#endif
+  }
   return metadata;
 }
 
