+void FullscreenController::OnTabDeactivated(WebContents* web_contents) {
+  if (jithubrowser::features::IsOn(jithubrowser::features::kJithuBrowserSilentTabFullscreenExit) &&
+      web_contents == exclusive_access_tab() && tab_fullscreen_ &&
+      IsFullscreenCausedByTab() && !IsFullscreenWithinTab(web_contents) &&
+      !IsRunningInAppMode()) {
+    // A tab that is fullscreen at its own request is being switched away from. Leave window fullscreen as
+    // usual but do not tell the page; fullscreen is restored in OnTabActivated().
+    if (jithu_hidden_fullscreen_tab_ &&
+        jithu_hidden_fullscreen_tab_.get() != web_contents) {
+      // Another tab was already held this way: let it go for real.
+      jithu_hidden_fullscreen_tab_->ExitFullscreen(/*will_cause_resize=*/true);
+    }
+    jithu_hidden_fullscreen_tab_ = web_contents->GetWeakPtr();
+    jithu_silent_exit_ = true;
+    ExitFullscreenModeInternal();
+    return;
+  }
+  ExclusiveAccessControllerBase::OnTabDeactivated(web_contents);
+}
+
+void FullscreenController::OnTabActivated(WebContents* web_contents) {
+  if (!jithu_hidden_fullscreen_tab_ ||
+      web_contents != jithu_hidden_fullscreen_tab_.get()) {
+    return;
+  }
+  jithu_hidden_fullscreen_tab_.reset();
+  jithu_silent_exit_ = false;
+  if (exclusive_access_tab()) {
+    // The window had not finished leaving fullscreen yet: nothing to restore.
+    return;
+  }
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(jithu_requesting_frame_id_);
+  if (!frame || !CanEnterFullscreenModeForTab(frame)) {
+    // Cannot restore: tell the page the truth instead of leaving it in a wrong state.
+    web_contents->ExitFullscreen(/*will_cause_resize=*/true);
+    return;
+  }
+  EnterFullscreenModeForTab(frame, jithu_fullscreen_params_);
+}
