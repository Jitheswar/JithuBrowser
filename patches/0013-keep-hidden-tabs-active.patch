+// JithuBrowser: hidden tabs keep painting and are not throttled (like a captured tab), so a page cannot
+// tell it is in the background from timer or animation-frame rates. Only what is *sent to renderers* is
+// changed; tab activation, accessibility and the back/forward cache keep the real hidden state.
+namespace {
+PageVisibilityState JithuBrowserRendererPageVisibility(PageVisibilityState real) {
+  if (real == PageVisibilityState::kHidden &&
+      base::FeatureList::IsEnabled(
+          jithubrowser::features::kJithuBrowserKeepHiddenTabsActive)) {
+    return PageVisibilityState::kHiddenButPainting;
+  }
+  return real;
+}
