 namespace blink {
 
+namespace {
+
+// JithuBrowser: height reported for browser chrome (tab strip + toolbar) so
+// outerHeight looks like an ordinary maximised Chrome window.
+constexpr int kJithuBrowserChromeHeight = 85;
+
+// JithuBrowser: window.outer{Width,Height} are derived from the outermost main
+// frame's visible viewport instead of the real OS window, so the OS window
+// size, side panels, page zoom and F11 fullscreen are not observable. Subframe
+// widgets (including out-of-process iframes) receive the main frame's visible
+// viewport from the browser, so every frame reports the same values.
+std::optional<gfx::Size> JithuBrowserOuterSize(LocalFrame* frame) {
+  if (!base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserHideWindowGeometry)) {
+    return std::nullopt;
+  }
+  WebLocalFrameImpl* web_frame = WebLocalFrameImpl::FromFrame(frame);
+  if (!web_frame || !web_frame->LocalRootFrameWidget() || !frame->GetPage()) {
+    return std::nullopt;
+  }
+  gfx::Size device_px =
+      web_frame->LocalRootFrameWidget()->VisibleViewportSize();
+  float dsf = frame->GetPage()
+                  ->GetChromeClient()
+                  .GetScreenInfo(*frame)
+                  .device_scale_factor;
+  if (device_px.IsEmpty() || dsf <= 0) {
+    return std::nullopt;
+  }
+  gfx::Size dips = gfx::ScaleToCeiledSize(device_px, 1.f / dsf);
+  return gfx::Size(dips.width(), dips.height() + kJithuBrowserChromeHeight);
+}
+
