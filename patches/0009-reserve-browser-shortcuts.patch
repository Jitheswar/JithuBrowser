diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 3741ba7671..1f3b2466a9 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -189,6 +189,7 @@
 
 #if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
 #include "chrome/browser/ui/shortcuts/desktop_shortcuts_utils.h"
+#include "third_party/blink/public/common/jithubrowser_features.h"
 #endif  // BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
 
 static_assert(BUILDFLAG(ENABLE_EXTENSIONS));
@@ -532,14 +533,36 @@ bool BrowserCommandController::IsReservedCommandOrKey(
   }
 #endif
 
-  return command_id == IDC_CLOSE_TAB || command_id == IDC_CLOSE_WINDOW ||
-         command_id == IDC_NEW_INCOGNITO_WINDOW ||
-         command_id == IDC_NEW_ISOLATED_WINDOW || command_id == IDC_NEW_TAB ||
-         command_id == IDC_NEW_WINDOW || command_id == IDC_RESTORE_TAB ||
-         command_id == IDC_SELECT_NEXT_TAB ||
-         command_id == IDC_SELECT_PREVIOUS_TAB ||
-         command_id == IDC_CYCLE_TO_NEXT_TAB ||
-         command_id == IDC_CYCLE_TO_PREV_TAB || command_id == IDC_EXIT;
+  const bool upstream_reserved =
+      command_id == IDC_CLOSE_TAB || command_id == IDC_CLOSE_WINDOW ||
+      command_id == IDC_NEW_INCOGNITO_WINDOW ||
+      command_id == IDC_NEW_ISOLATED_WINDOW || command_id == IDC_NEW_TAB ||
+      command_id == IDC_NEW_WINDOW || command_id == IDC_RESTORE_TAB ||
+      command_id == IDC_SELECT_NEXT_TAB ||
+      command_id == IDC_SELECT_PREVIOUS_TAB ||
+      command_id == IDC_CYCLE_TO_NEXT_TAB ||
+      command_id == IDC_CYCLE_TO_PREV_TAB || command_id == IDC_EXIT;
+
+  // JithuBrowser: the remaining browser shortcuts (find, reload, zoom, history,
+  // bookmarks, ...) are handled by the browser and never offered to the page,
+  // so a site cannot learn which shortcuts the user presses. This runs after
+  // every upstream exemption above (fullscreen pages, Linux text-editing
+  // hotkeys), so those keep working. Text-editing commands and Escape stay
+  // with the page: web editors and pages that handle Escape need to see them.
+  if (!upstream_reserved &&
+      base::FeatureList::IsEnabled(
+          jithubrowser::features::kJithuBrowserProtectKeyboard)) {
+    switch (command_id) {
+      case IDC_CUT:
+      case IDC_COPY:
+      case IDC_PASTE:
+      case IDC_CLOSE_FIND_OR_STOP:
+        return false;
+      default:
+        return true;
+    }
+  }
+  return upstream_reserved;
 }
 
