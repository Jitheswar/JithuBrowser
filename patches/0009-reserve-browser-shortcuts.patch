+  // JithuBrowser: browser shortcuts (find, new tab, reload, zoom, history,
+  // bookmarks, ...) are handled by the browser and never offered to the page,
+  // so a site cannot learn which shortcuts the user presses. Text-editing
+  // commands are excluded: web editors need to see them to work.
+  if (base::FeatureList::IsEnabled(jithubrowser::features::kJithuBrowserProtectKeyboard)) {
+    switch (command_id) {
+      case IDC_CUT:
+      case IDC_COPY:
+      case IDC_PASTE:
+        return false;
+      default:
+        return true;
+    }
+  }
