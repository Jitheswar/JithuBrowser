--- /dev/null
+++ b/chrome/browser/resources/emulated_extensions/emulator.js
@@ -0,0 +1,86 @@
+// JithuBrowser "Extension Emulator" content script.
+//
+// Some web applications require a specific browser extension and verify its
+// presence with a window.postMessage protocol: the page broadcasts a typed
+// request message and the extension's content script answers with a typed
+// message listing the enabled extensions. Without the real extension the
+// page blocks the user.
+//
+// This script (bundled as a component extension) answers those protocols for
+// the sites listed below, as if the required extension were installed. It is
+// inert on every other page: it only reacts to messages whose type exactly
+// matches a known request type on a matching host. It never reads the
+// browser's real extension list and makes no network requests.
+
+"use strict";
+
+(() => {
+  // One entry per known extension-check protocol.
+  const PROTOCOLS = [
+    {
+      // Host-suffix match against location.hostname (the host itself or any
+      // of its subdomains).
+      sites: ["smartinterviews.in"],
+      // The page posts {type: requestType} on window.
+      requestType: "CHECK_EXTENSIONS_REQUEST",
+      // The answer is posted back as {type: responseType, ...}.
+      responseType: "FORBIDDEN_EXTENSIONS",
+      // Enabled extensions reported to the page. The page requires the
+      // first one; anything else in the list is treated as forbidden, so
+      // only the required extension is reported.
+      extensions: [
+        {
+          id: "goknflnoeiaookhdbnldcbnodjahpgdh",
+          name: "Hive - Extension Detector",
+          version: "1.2"
+        }
+      ],
+      // Extra fields the real bridge includes in its answer.
+      extra: {isPermissionGiven: true},
+      // Answer once shortly after load, like the real bridge does.
+      proactive: true
+    }
+  ];
+
+  const host = (location.hostname || "").toLowerCase();
+
+  const matchesSites = (sites) =>
+    sites.some((s) => {
+      const suffix = s.toLowerCase();
+      return host === suffix || host.endsWith("." + suffix);
+    });
+
+  const active = PROTOCOLS.filter((p) => matchesSites(p.sites));
+  if (active.length === 0) return;
+
+  const respond = (p) => {
+    const message = {
+      type: p.responseType,
+      enabledExtensions: p.extensions
+    };
+    Object.assign(message, p.extra || {});
+    window.postMessage(message, "*");
+  };
+
+  window.addEventListener(
+    "message",
+    (event) => {
+      if (event.source !== window) return;
+      const data = event.data;
+      if (!data || typeof data !== "object") return;
+      for (const p of active) {
+        if (data.type === p.requestType) {
+          // The real bridge answers from its background worker, i.e. on a
+          // later task; do the same so the timing looks like a round trip.
+          setTimeout(() => respond(p), 0);
+          break;
+        }
+      }
+    },
+    false
+  );
+
+  if (active.some((p) => p.proactive)) {
+    setTimeout(() => active.forEach((p) => p.proactive && respond(p)), 0);
+  }
+})();
