+// JithuBrowser: typing rhythm (dwell and flight times between key events) is a
+// well-known behavioural biometric. Event timestamps are shifted back by a
+// small random amount, kept monotonic and never in the future, so intervals
+// between keystrokes no longer identify the typist. Delivery order and timing
+// of the events themselves (and so preventDefault) are unchanged.
+base::TimeTicks JithuBrowserJitterKeyTimeStamp(base::TimeTicks ts) {
+  if (!jithubrowser::features::IsOn(jithubrowser::features::kJithuBrowserKeystrokeJitter) || ts.is_null()) {
+    return ts;
+  }
+  thread_local base::TimeTicks last_stamp;
+  const int max_ms = jithubrowser::features::kJithuBrowserKeystrokeJitterMaxMs.Get();
+  base::TimeTicks jittered =
+      ts - base::RandTimeDeltaUpTo(base::Milliseconds(std::max(1, max_ms)));
+  if (jittered < last_stamp) {
+    jittered = last_stamp;
+  }
+  if (jittered > ts) {
+    jittered = ts;
+  }
+  last_stamp = jittered;
+  return jittered;
+}
