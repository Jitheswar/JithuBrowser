+namespace {
+
+constexpr char kPref[] = "jithubrowser.unprotected_sites";
+constexpr char kHidePref[] = "jithubrowser.hide_menu_items";
+
+constexpr char kPage[] = R"HTML(<!doctype html>
+<html lang="en"><head><meta charset="utf-8">
+<title>JithuBrowser settings</title>
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<link rel="stylesheet" href="style.css">
+</head><body>
+<main>
+  <h1>JithuBrowser</h1>
+  <p class="sub" id="version"></p>
+  <section>
+    <h2>Sites with protections off</h2>
+    <p>On these sites (and their subdomains) the in-page protections are turned off
+       (visibility, focus, history, canvas/WebGL/audio and so on). The User-Agent,
+       browser shortcuts and silent fullscreen stay on. Reload the site after a change.</p>
+    <form id="add"><input id="host" placeholder="example.com" autocomplete="off" spellcheck="false">
+      <button type="submit">Add site</button></form>
+    <ul id="sites"></ul>
+    <p class="empty" id="empty">No sites. Protections are on everywhere.</p>
+  </section>
+  <section>
+    <h2>Main menu</h2>
+    <p>The main menu has two JithuBrowser entries: <b>JithuBrowser protections for this
+       site</b> (a quick per-site switch) and <b>JithuBrowser settings</b> (this page).
+       You can hide them. This page stays reachable at <b>chrome://jithubrowser-settings</b>.</p>
+    <label class="check"><input type="checkbox" id="hideMenu"> Hide the JithuBrowser items in the main menu</label>
+  </section>
+  <section>
+    <h2>Quiet mode (Google background requests)</h2>
+    <p>Stock Chromium contacts Google services on its own (component updates, push messaging,
+       account and time checks). Start JithuBrowser with <b>--jithubrowser-quiet-google</b> to stop
+       those. Trade-offs: DRM (Widevine) and certificate-revocation lists stop updating, and
+       websites can no longer send you push notifications.</p>
+  </section>
+</main>
+<script src="script.js"></script>
+</body></html>)HTML";
+
+constexpr char kCss[] = R"CSS(
+:root { color-scheme: light dark; --bg:#f6f7fb; --fg:#161a2b; --card:#fff; --muted:#5b6482; --accent:#6d5df6; --line:#e1e4f0; }
+@media (prefers-color-scheme: dark) { :root { --bg:#0e1226; --fg:#e8ebf8; --card:#171c36; --muted:#98a2c8; --line:#262d52; } }
+body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 system-ui, "Segoe UI", sans-serif; }
+main { max-width:680px; margin:0 auto; padding:32px 20px 64px; }
+h1 { margin:0; font-size:28px; background:linear-gradient(90deg,#22d3ee,#8b5cf6); -webkit-background-clip:text; background-clip:text; color:transparent; }
+.sub { margin:4px 0 24px; color:var(--muted); }
+section { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:18px 20px; margin-bottom:16px; }
+h2 { margin:0 0 6px; font-size:17px; }
+p { color:var(--muted); margin:6px 0 12px; }
+form { display:flex; gap:8px; margin-bottom:10px; }
+label.check { display:flex; align-items:center; gap:10px; cursor:pointer; }
+label.check input { flex:none; width:18px; height:18px; }
+input:not([type=checkbox]) { flex:1; padding:9px 12px; border:1px solid var(--line); border-radius:9px; background:transparent; color:var(--fg); font:inherit; }
+button { padding:9px 14px; border:0; border-radius:9px; background:var(--accent); color:#fff; font:inherit; cursor:pointer; }
+button.remove { background:transparent; color:var(--accent); border:1px solid var(--line); padding:5px 10px; }
+ul { list-style:none; padding:0; margin:0; }
+li { display:flex; align-items:center; justify-content:space-between; padding:9px 0; border-top:1px solid var(--line); }
+.empty { margin:8px 0 0; }
+)CSS";
+
+constexpr char kJs[] = R"JS(
+function render(state) {
+  document.getElementById('version').textContent = state.version;
+  document.getElementById('hideMenu').checked = state.hideMenu;
+  const ul = document.getElementById('sites');
+  ul.textContent = '';
+  for (const host of state.sites) {
+    const li = document.createElement('li');
+    const name = document.createElement('span'); name.textContent = host;
+    const b = document.createElement('button'); b.className = 'remove'; b.textContent = 'Remove';
+    b.onclick = () => chrome.send('jithuRemoveSite', [host]);
+    li.append(name, b); ul.append(li);
+  }
+  document.getElementById('empty').style.display = state.sites.length ? 'none' : 'block';
+}
+window.jithuState = render;
+document.getElementById('hideMenu').onchange = (e) => chrome.send('jithuSetHideMenu', [e.target.checked]);
+document.getElementById('add').onsubmit = (e) => {
+  e.preventDefault();
+  const input = document.getElementById('host');
+  const v = input.value.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
+  if (v) chrome.send('jithuAddSite', [v]);
+  input.value = '';
+};
+chrome.send('jithuGetState');
+)JS";
+
+class MessageHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "jithuGetState",
+        base::BindRepeating(&MessageHandler::Send, base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "jithuAddSite", base::BindRepeating(&MessageHandler::Add,
+                                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "jithuSetHideMenu", base::BindRepeating(&MessageHandler::SetHideMenu,
+                                                base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "jithuRemoveSite", base::BindRepeating(&MessageHandler::Remove,
+                                               base::Unretained(this)));
+  }
+
+ private:
+  PrefService* prefs() {
+    return Profile::FromWebUI(web_ui())->GetPrefs();
+  }
+
+  void Send(const base::ListValue&) {
+    base::DictValue state;
+    state.Set("version",
+              std::string("Version ") + std::string(version_info::GetVersionNumber()) +
+                  "." + base::NumberToString(jithubrowser::features::kJithuBrowserRevision));
+    base::ListValue sites;
+    for (const auto& v : prefs()->GetList(kPref)) {
+      if (v.is_string()) {
+        sites.Append(v.GetString());
+      }
+    }
+    state.Set("sites", std::move(sites));
+    state.Set("hideMenu", prefs()->GetBoolean(kHidePref));
+    base::Value arg(std::move(state));
+    web_ui()->CallJavascriptFunctionUnsafe("window.jithuState", arg);
+  }
+
+  void SetHideMenu(const base::ListValue& args) {
+    if (!args.empty() && args[0].is_bool()) {
+      prefs()->SetBoolean(kHidePref, args[0].GetBool());
+    }
+    Send({});
+  }
+
+  void Add(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::string host = base::ToLowerASCII(args[0].GetString());
+    if (host.empty() || host.size() > 253 ||
+        host.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789.-") !=
+            std::string::npos) {
+      return;
+    }
+    ScopedListPrefUpdate update(prefs(), kPref);
+    for (const auto& v : update.Get()) {
+      if (v.is_string() && v.GetString() == host) {
+        Send({});
+        return;
+      }
+    }
+    update.Get().Append(host);
+    Send({});
+  }
+
+  void Remove(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const std::string host = args[0].GetString();
+    ScopedListPrefUpdate update(prefs(), kPref);
+    auto& list = update.Get();
+    for (auto it = list.begin(); it != list.end();) {
+      if (it->is_string() && it->GetString() == host) {
+        it = list.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    Send({});
+  }
+};
+
+bool ShouldHandle(const std::string& path) {
+  return path.empty() || path == "index.html" || path == "style.css" ||
+         path == "script.js";
+}
+
+void Handle(const std::string& path,
+            content::WebUIDataSource::GotDataCallback callback) {
+  const char* body = kPage;
+  if (path == "style.css") {
+    body = kCss;
+  } else if (path == "script.js") {
+    body = kJs;
+  }
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedStaticMemory>(
+          base::as_byte_span(std::string_view(body))));
+}
+
+}  // namespace
+
+JithuSettingsUI::JithuSettingsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), kChromeUIJithuSettingsHost);
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandle),
+                           base::BindRepeating(&Handle));
+  web_ui->AddMessageHandler(std::make_unique<MessageHandler>());
+}
+
+JithuSettingsUI::~JithuSettingsUI() = default;
