+std::string HexOfFileSha256(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::string();
+  }
+  auto hash = crypto::SecureHash::Create(crypto::SecureHash::SHA256);
+  std::vector<uint8_t> buffer(1 << 20);
+  while (true) {
+    std::optional<size_t> n = file.ReadAtCurrentPos(buffer);
+    if (!n.has_value()) {
+      return std::string();
+    }
+    if (*n == 0) {
+      break;
+    }
+    hash->Update(base::span<const uint8_t>(buffer).first(*n));
+  }
+  uint8_t digest[32];
+  hash->Finish(digest);
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
