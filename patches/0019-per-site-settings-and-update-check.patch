 using content::WebContents;
 
+namespace jithubrowser {
+namespace {
+constexpr char kUnprotectedSitesPref[] = "jithubrowser.unprotected_sites";
+constexpr char kUnprotectedSitesSwitch[] = "jithubrowser-unprotected-sites";
+
+bool HostMatches(const std::string& host, const std::string& entry) {
+  if (entry.empty()) {
+    return false;
+  }
+  return host == entry ||
+         (host.size() > entry.size() + 1 &&
+          host.compare(host.size() - entry.size(), entry.size(), entry) == 0 &&
+          host[host.size() - entry.size() - 1] == '.');
+}
+
+bool IsUnprotected(PrefService* prefs, const GURL& url) {
+  if (!url.is_valid() || url.host().empty() ||
+      !base::FeatureList::IsEnabled(
+          jithubrowser::features::kJithuBrowserSiteSettings)) {
+    return false;
+  }
+  const std::string host(url.host());
+  for (const auto& entry : prefs->GetList(kUnprotectedSitesPref)) {
+    if (entry.is_string() && HostMatches(host, entry.GetString())) {
+      return true;
+    }
+  }
+  const std::string flag =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kUnprotectedSitesSwitch);
+  for (const auto& entry : base::SplitString(
+           flag, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (HostMatches(host, entry)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Tells the renderer whether protections apply to the site being loaded.
+class SiteSettingsTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<SiteSettingsTabHelper> {
+ public:
+  ~SiteSettingsTabHelper() override = default;
+
+  void Update(const GURL& url) {
+    Profile* profile =
+        Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+    const bool off = IsUnprotected(profile->GetPrefs(), url);
+    auto* prefs = web_contents()->GetMutableRendererPrefs();
+    if (prefs->jithu_protections_off != off) {
+      prefs->jithu_protections_off = off;
+      web_contents()->SyncRendererPrefs();
+    }
+  }
+
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      Update(handle->GetURL());
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<SiteSettingsTabHelper>;
+  explicit SiteSettingsTabHelper(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<SiteSettingsTabHelper>(*web_contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SiteSettingsTabHelper);
+}  // namespace
+
+void RegisterSiteSettingsPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kUnprotectedSitesPref);
+}
+
+bool IsSiteProtected(content::WebContents* web_contents) {
+  Profile* profile = Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  return !IsUnprotected(profile->GetPrefs(), web_contents->GetLastCommittedURL());
+}
+
+void ToggleSiteProtection(content::WebContents* web_contents) {
+  const GURL url = web_contents->GetLastCommittedURL();
+  if (!url.is_valid() || url.host().empty()) {
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  const std::string host(url.host());
+  ScopedListPrefUpdate update(profile->GetPrefs(), kUnprotectedSitesPref);
+  auto& list = update.Get();
+  bool removed = false;
+  for (auto it = list.begin(); it != list.end();) {
+    if (it->is_string() && HostMatches(host, it->GetString())) {
+      it = list.erase(it);
+      removed = true;
+    } else {
+      ++it;
+    }
+  }
+  if (!removed) {
+    list.Append(host);
+  }
+  if (auto* helper = SiteSettingsTabHelper::FromWebContents(web_contents)) {
+    helper->Update(url);
+  }
+}
