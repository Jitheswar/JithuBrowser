+// Downloads the installer, checks its SHA-256 against the release's
+// SHA256SUMS, and starts it (its setup window shows progress). Deletes itself.
+class UpdateInstaller {
+ public:
+  static void Start(std::string version, std::string installer_url,
+                    std::string sums_url) {
+    (new UpdateInstaller(std::move(version), std::move(installer_url),
+                         std::move(sums_url)))
+        ->FetchSums();
+  }
+
+ private:
+  UpdateInstaller(std::string version, std::string installer_url,
+                  std::string sums_url)
+      : version_(std::move(version)),
+        installer_url_(std::move(installer_url)),
+        sums_url_(std::move(sums_url)) {}
+
+  static bool IsReleaseUrl(const std::string& url) {
+    return base::StartsWith(
+        url, "https://github.com/Jitheswar/JithuBrowser/releases/download/");
+  }
+
+  void Fail(const char* why) {
+    VLOG(1) << "jithu update: install failed: " << why;
+    if (progress_) {
+      progress_->Dismiss();
+    }
+    ShowMessage(u"JithuBrowser could not install the update automatically. "
+                u"Please download it from the Releases page.",
+                true);
+    delete this;
+  }
+
+  void FetchSums() {
+    if (!IsReleaseUrl(installer_url_) || !IsReleaseUrl(sums_url_)) {
+      Fail("unexpected url");
+      return;
+    }
+    ShowMessage(u"Downloading JithuBrowser " + base::UTF8ToUTF16(version_) +
+                    u" in the background...",
+                false, &progress_);
+    sums_loader_ = MakeLoader(sums_url_);
+    sums_loader_->DownloadToString(
+        g_browser_process->shared_url_loader_factory().get(),
+        base::BindOnce(&UpdateInstaller::GotSums, base::Unretained(this)),
+        64 * 1024);
+  }
+
+  std::unique_ptr<network::SimpleURLLoader> MakeLoader(const std::string& url) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(url);
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    net::NetworkTrafficAnnotationTag tag = net::DefineNetworkTrafficAnnotation(
+        "jithubrowser_update_download", R"(
+        semantics {
+          sender: "JithuBrowser update installer"
+          description:
+            "Downloads the newer JithuBrowser installer the user chose to "
+            "install, plus its checksum file."
+          trigger: "The user clicked Install update."
+          data: "None."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Only runs after the user clicks Install update."
+          policy_exception_justification: "Not implemented."
+        })");
+    return network::SimpleURLLoader::Create(std::move(request), tag);
+  }
+
+  void GotSums(std::optional<std::string> body) {
+    if (!body) {
+      Fail("sums download");
+      return;
+    }
+    const std::string name = installer_url_.substr(installer_url_.rfind('/') + 1);
+    for (const auto& line : base::SplitString(*body, "\n", base::TRIM_WHITESPACE,
+                                              base::SPLIT_WANT_NONEMPTY)) {
+      const size_t sp = line.find("  ");
+      if (sp == 64 && line.substr(sp + 2) == name) {
+        expected_sha_ = base::ToLowerASCII(line.substr(0, 64));
+      }
+    }
+    base::FilePath dir;
+    if (expected_sha_.size() != 64 || !base::CreateNewTempDirectory(
+                                          FILE_PATH_LITERAL("JithuBrowserUpdate"), &dir)) {
+      Fail("no checksum or temp dir");
+      return;
+    }
+    file_ = dir.AppendASCII(name);
+    download_ = MakeLoader(installer_url_);
+    download_->DownloadToFile(
+        g_browser_process->shared_url_loader_factory().get(),
+        base::BindOnce(&UpdateInstaller::GotInstaller, base::Unretained(this)),
+        file_, 600 * 1024 * 1024);
+  }
+
+  void GotInstaller(base::FilePath path) {
+    if (path.empty()) {
+      Fail("installer download");
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&HexOfFileSha256, path),
+        base::BindOnce(&UpdateInstaller::Verified, base::Unretained(this)));
+  }
+
+  void Verified(std::string actual) {
+    if (actual != expected_sha_) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce([](base::FilePath f) { base::DeleteFile(f); }, file_));
+      Fail("checksum mismatch");
+      return;
+    }
+    VLOG(1) << "jithu update: checksum verified, launching installer";
+    base::LaunchOptions options;
+    if (!base::LaunchProcess(base::CommandLine(file_), options).IsValid()) {
+      Fail("launch");
+      return;
+    }
+    if (progress_) {
+      progress_->Dismiss();
+    }
+    ShowMessage(u"The update was downloaded and checked. The setup window is "
+                u"installing it; restart JithuBrowser when it finishes.",
+                true);
+    delete this;
+  }
+
+  std::string version_, installer_url_, sums_url_, expected_sha_;
+  base::FilePath file_;
+  std::unique_ptr<network::SimpleURLLoader> sums_loader_, download_;
+  base::WeakPtr<MessageInfoBarDelegate> progress_;
+};
