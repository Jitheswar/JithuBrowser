+class UpdateChecker {
+ public:
+  // Test and automation setups must not phone home.
+  static bool IsAutomated() {
+    const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    return cl->HasSwitch("remote-debugging-port") ||
+           cl->HasSwitch("remote-debugging-pipe") ||
+           cl->HasSwitch("enable-automation");
+  }
+
+  static void ScheduleOnce() {
+    VLOG(1) << "jithu update: ScheduleOnce";
+    static bool scheduled = false;
+    if (scheduled ||
+        !jithubrowser::features::IsOn(
+            jithubrowser::features::kJithuBrowserUpdateCheck) ||
+        IsAutomated()) {
+      return;
+    }
+    scheduled = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce([] { (new UpdateChecker)->Start(); }),
+        base::Seconds(30));
+  }
+
+ private:
+  void Start() {
+    VLOG(1) << "jithu update: requesting releases";
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(kReleasesApi);
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->headers.SetHeader("Accept", "application/vnd.github+json");
+    net::NetworkTrafficAnnotationTag tag = net::DefineNetworkTrafficAnnotation(
+        "jithubrowser_update_check", R"(
+        semantics {
+          sender: "JithuBrowser update check"
+          description:
+            "Asks GitHub for the newest JithuBrowser release so the browser "
+            "can tell the user that an update exists. Nothing is installed."
+          trigger: "Once, 30 seconds after the browser starts."
+          data: "None beyond a normal HTTPS request (no cookies)."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Start with --disable-features=JithuBrowserUpdateCheck."
+          policy_exception_justification: "Not implemented."
+        })");
+    loader_ = network::SimpleURLLoader::Create(std::move(request), tag);
+    loader_->DownloadToString(
+        g_browser_process->shared_url_loader_factory().get(),
+        base::BindOnce(&UpdateChecker::Done, base::Unretained(this)),
+        256 * 1024);
+  }
+
+  void Done(std::optional<std::string> body) {
+    VLOG(1) << "jithu update: response " << (body ? body->size() : 0) << " bytes";
+    std::string tag;
+    if (body) {
+      const size_t key = body->find("\"tag_name\"");
+      const size_t q1 = key == std::string::npos
+                            ? std::string::npos
+                            : body->find('"', body->find(':', key) + 1);
+      const size_t q2 =
+          q1 == std::string::npos ? std::string::npos : body->find('"', q1 + 1);
+      if (q2 != std::string::npos) {
+        tag = body->substr(q1 + 1, q2 - q1 - 1);
+      }
+    }
+    if (!tag.empty() && tag[0] == 'v') {
+      tag.erase(0, 1);
+    }
+    std::vector<int> latest = ParseVersion(tag);
+    std::vector<int> current = ParseVersion(
+        std::string(version_info::GetVersionNumber()) + "." +
+        base::NumberToString(TestRevisionOverride().value_or(
+            jithubrowser::features::kJithuBrowserRevision)));
+    std::string installer_url, sums_url;
+    if (body) {
+      size_t pos = 0;
+      const std::string key = "\"browser_download_url\"";
+      while ((pos = body->find(key, pos)) != std::string::npos) {
+        pos += key.size();
+        // GitHub formats this as "key": "url" (with a space); accept both.
+        pos = body->find('"', pos);
+        if (pos == std::string::npos) {
+          break;
+        }
+        ++pos;
+        const size_t end = body->find('"', pos);
+        if (end == std::string::npos) {
+          break;
+        }
+        const std::string url = body->substr(pos, end - pos);
+        if (url.find("-windows-x64-installer.exe") != std::string::npos) {
+          installer_url = url;
+        } else if (url.size() > 10 &&
+                   url.compare(url.size() - 10, 10, "SHA256SUMS") == 0) {
+          sums_url = url;
+        }
+        pos = end;
+      }
+    }
+    VLOG(1) << "jithu update: latest=" << tag << " newer=" << (latest > current);
+    if (!latest.empty() && !current.empty() && latest > current) {
+      // --jithubrowser-test-install-now skips the bar (used to test the download
+      // and checksum pipeline on any platform).
+      if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+              "jithubrowser-test-install-now")) {
+        UpdateInstaller::Start(tag, installer_url, sums_url);
+      } else if (auto* manager = ActiveInfoBarManager()) {
+        manager->AddInfoBar(CreateConfirmInfoBar(
+            std::make_unique<UpdateInfoBarDelegate>(tag, installer_url,
+                                                    sums_url)));
+        VLOG(1) << "jithu update: infobar added";
+      }
+    }
+    delete this;
+  }
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+};
