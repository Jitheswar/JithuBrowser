+constexpr char kReleasesPage[] =
+    "https://github.com/Jitheswar/JithuBrowser/releases";
+
+std::vector<int> ParseVersion(const std::string& v) {
+  std::vector<int> out;
+  for (const auto& part : base::SplitString(v, ".", base::TRIM_WHITESPACE,
+                                            base::SPLIT_WANT_NONEMPTY)) {
+    int n = 0;
+    if (!base::StringToInt(part, &n)) {
+      return {};
+    }
+    out.push_back(n);
+  }
+  return out;
+}
