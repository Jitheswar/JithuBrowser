+  };
+
+  const onUnblockCut = (event) => {
+    let target = null;
+    try {
+      target = event.target;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+    } catch (_) {}
+    const domText = domSelectionText();
+    findMonacoEditor((ed) => {
+      let text = "";
+      let selection = null;
+      try {
+        selection = ed && ed.getSelection();
+        const model = ed && ed.getModel();
+        if (selection && model) text = model.getValueInRange(selection);
