+// JithuBrowser "Extension Emulator" - killed-paste fallback (MAIN world).
+//
+// The clipboard unblock (see emulator.js, isolated world) normally feeds the
+// page's own copy recorder and lets the paste proceed natively. The one case
+// it cannot reach: a page paste interceptor registered before our handler
+// (e.g. at parse time / SSR'd state) that kills the event with
+// stopImmediatePropagation(), so no later listener - in any world - runs.
+//
+// The page invokes Event.prototype.stopImmediatePropagation() through the
+// MAIN world's prototype; interface prototypes are per-world, so this script
+// must run in the page's main world to observe the call. It is inert until
+// the isolated-world unblock activates it for this page (the
+// "__jb_clipboard_unblock" CustomEvent dispatched by emulator.js when it
+// installs the unblock), so on every other page it only forwards the
+// original method.
+//
+// When a paste is killed while the unblock is active, once the dispatch has
+// settled the text is inserted directly where a native paste would have
+// landed (Monaco editor, form field, or contenteditable).
+
+(() => {
+  "use strict";
+  if (window.__jbSipFallback) return;
+  window.__jbSipFallback = true;
+
+  let unblockActive = false;
+  try {
+    window.addEventListener("__jb_clipboard_unblock", () => { unblockActive = true; });
+  } catch (_) {}
+
+  const settled = new WeakSet();
+
+  const findMonacoEditor = () => {
+    try {
+      const monaco = window.monaco;
+      if (monaco && monaco.editor && typeof monaco.editor.getEditors === "function") {
+        const editors = monaco.editor.getEditors();
+        for (const e of editors) {
+          try { if (e.hasControl()) return e; } catch (_) {}
+        }
+        if (editors.length) return editors[editors.length - 1];
+      }
+    } catch (_) {}
+    return null;
+  };
+
+  const textLanded = (text, target) => {
+    const editor = findMonacoEditor();
+    try {
+      if (editor) {
+        const model = editor.getModel();
+        if (model && typeof model.getValue === "function" &&
+            model.getValue().indexOf(text) !== -1) return true;
+      }
+    } catch (_) {}
+    try {
+      if (target && typeof target.value === "string") {
+        if (target.value.indexOf(text) !== -1) return true;
+      } else if (target && target.textContent) {
+        if (target.textContent.indexOf(text) !== -1) return true;
+      }
+    } catch (_) {}
+    return false;
+  };
+
+  const insertText = (text, target) => {
+    const editor = findMonacoEditor();
+    if (editor) {
+      try {
+        const sel = editor.getSelection();
+        const model = editor.getModel();
+        if (sel && model) editor.executeEdits("jb", [{ range: sel, text: text }]);
+        else editor.trigger("jb", "type", { text: text });
+        return;
+      } catch (_) {}
+    }
+    try {
+      if (target && (target.tagName === "TEXTAREA" || target.tagName === "INPUT")) {
+        target.setRangeText(text, target.selectionStart,
+          target.selectionEnd ?? target.selectionStart, "end");
+        target.dispatchEvent(new Event("input", { bubbles: true }));
+      } else if (target && target.isContentEditable) {
+        document.execCommand("insertText", false, text);
+      }
+    } catch (_) {}
+  };
+
+  try {
+    const stopImmediatePropagation = Event.prototype.stopImmediatePropagation;
+    Event.prototype.stopImmediatePropagation = function () {
+      try {
+        if (this.type === "paste" && unblockActive && !settled.has(this)) {
+          settled.add(this);
+          let text = "";
+          try {
+            const data = this.clipboardData;
+            if (data) text = data.getData("text/plain") || "";
+          } catch (_) {}
+          const event = this;
+          if (text) {
+            setTimeout(() => {
+              try {
+                let target = null;
+                try { target = event.target; } catch (_) {}
+                if (!textLanded(text, target)) insertText(text, target);
+              } catch (_) {}
+            }, 0);
+          }
+        }
+      } catch (_) {}
+      return stopImmediatePropagation.call(this);
+    };
+  } catch (_) {}
+})();
