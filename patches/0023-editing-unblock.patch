+  // ---------------------------------------------------------------------------
+  // Editing unblock (registry flag: "clipboardUnblock")
+  //
+  // Some supported sites disable ordinary editing inside the page: a
+  // capture-phase paste interceptor that only accepts text the page itself
+  // recently recorded (its in-memory "last copied" value per contest),
+  // document capture listeners that block copy/cut/drag-and-drop, and a
+  // context-menu handler that swallows right-click. When the registry entry
+  // for the current host enables this, the page's own checks are satisfied
+  // with the page's own mechanisms, so the user gets normal browser editing
+  // behavior while the page's logic keeps running unchanged.
+  //
+  // Paste: the pasted text is re-recorded with the page's own copy recording
+  // before the page's later-registered paste interceptor evaluates its
+  // whitelist, so the page's own check passes and the paste proceeds
+  // natively. If the page's interceptor was registered first (it stops the
+  // event before this script's own paste handler can run), the text is
+  // inserted directly into the focused editor once the event settles.
+  // ---------------------------------------------------------------------------
+  const CLIPBOARD_SHIFT = 123;          // the page's letter-shift constant
+  const CLIPBOARD_KEY = "copiedData";   // the page's in-page clipboard key
+
+  const shiftLetters = (text) => {
+    let out = "";
+    for (let i = 0; i < text.length; i++) {
+      const ch = text[i];
+      if (/[a-zA-Z]/.test(ch)) {
+        const code = ch.charCodeAt(0);
+        const base = ch >= "a" && ch <= "z" ? 97 : 65;
+        out += String.fromCharCode(
+          ((code - base + (i + 1) * CLIPBOARD_SHIFT) % 26 + 26) % 26 + base);
+      } else {
+        out += ch;
+      }
+    }
+    return out;
+  };
