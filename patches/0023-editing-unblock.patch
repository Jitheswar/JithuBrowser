+  const onUnblockDragOver = (event) => {
+    // Skip the page's blocker; do not preventDefault, so drops stay allowed.
+    try { event.stopImmediatePropagation(); } catch (_) {}
+  };
+
+  const onUnblockDrop = (event) => {
+    let text = "";
+    let target = null;
+    try {
+      target = event.target;
+      if (event.dataTransfer) text = event.dataTransfer.getData("text/plain") || "";
+      event.preventDefault();
+      event.stopImmediatePropagation();
+    } catch (_) {}
