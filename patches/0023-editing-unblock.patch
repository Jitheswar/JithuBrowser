+      // re-arms its listeners over time.
+      window.addEventListener("paste", onUnblockPaste, true);
+      window.addEventListener("copy", onUnblockCopy, true);
+      window.addEventListener("cut", onUnblockCut, true);
+      window.addEventListener("contextmenu", onUnblockContextMenu, true);
+      window.addEventListener("dragover", onUnblockDragOver, true);
+      window.addEventListener("drop", onUnblockDrop, true);
+    } catch (_) {}
+  };
