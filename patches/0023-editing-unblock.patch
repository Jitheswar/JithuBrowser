+    const finish = (state) => {
+      if (!done) { done = true; cb(state || null); }
+    };
+    const grab = (monaco) => {
+      try {
+        const editors = monaco.editor.getEditors ? monaco.editor.getEditors() : [];
+        let ed = null;
+        for (const e of editors) {
+          try { if (e.hasControl()) { ed = e; break; } } catch (_) {}
+        }
+        if (!ed && editors.length) ed = editors[editors.length - 1];
+        if (ed) {
+          const sel = ed.getSelection();
+          const model = ed.getModel();
