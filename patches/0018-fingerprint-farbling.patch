 namespace blink {
 
+namespace {
+// JithuBrowser: returns pixels perturbed for fingerprinting protection, or
+// the original pixmap when nothing needs to change.
+const SkPixmap& JithuFarbled(const SkPixmap& in, SkBitmap* storage) {
+  if (!jithubrowser::features::IsOn(jithubrowser::features::kJithuBrowserFarbleCanvas) ||
+      (in.colorType() != kRGBA_8888_SkColorType &&
+       in.colorType() != kBGRA_8888_SkColorType)) {
+    return in;
+  }
+  if (!storage->tryAllocPixels(in.info()) ||
+      !in.readPixels(storage->pixmap())) {
+    return in;
+  }
+  jithubrowser::features::FarblePixels(
+      static_cast<uint8_t*>(storage->getPixels()), storage->rowBytes(),
+      in.width(), in.height(), in.alphaType() == kPremul_SkAlphaType);
+  return storage->pixmap();
+}
+}  // namespace
