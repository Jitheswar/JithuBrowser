# Maintainer: Jitheswar <jitheswaredu at gmail dot com>
# Installs the official JithuBrowser release build (built from patched official Chromium).
pkgname=jithubrowser-bin
pkgver=155.0.8059.39.8
pkgrel=1
pkgdesc="Privacy-focused web browser based on official Chromium"
arch=('x86_64')
url="https://github.com/Jitheswar/JithuBrowser"
license=('BSD-3-Clause')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'gtk3' 'libcups' 'libdrm' 'libxkbcommon' 'mesa'
         'nss' 'pango' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
         'libxrandr' 'xdg-utils' 'ttf-liberation')
provides=('jithubrowser')
conflicts=('jithubrowser')
options=('!strip' '!debug')
source=("https://github.com/Jitheswar/JithuBrowser/releases/download/v${pkgver}/jithubrowser-${pkgver}-linux-x64.tar.xz")
sha256sums=('f2e64b63f6393d9a689e3d264b598ac23e66bb6599a81ec7c6d288b27e25a3fe')

package() {
  local src="$srcdir/jithubrowser-${pkgver}-linux-x64"
  install -d "$pkgdir/opt/jithubrowser" "$pkgdir/usr/bin"
  cp -a "$src/." "$pkgdir/opt/jithubrowser/"
  rm -f "$pkgdir/opt/jithubrowser/"{README.txt,jithubrowser.desktop,product_logo_256.png}
  chmod 4755 "$pkgdir/opt/jithubrowser/chrome-sandbox"
  ln -s /opt/jithubrowser/jithubrowser-launcher "$pkgdir/usr/bin/jithubrowser"
  install -Dm644 "$src/jithubrowser.desktop" "$pkgdir/usr/share/applications/jithubrowser.desktop"
  install -Dm644 "$src/product_logo_256.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/jithubrowser.png"
  install -Dm644 "$src/LICENSE.JithuBrowser" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
