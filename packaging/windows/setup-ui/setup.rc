// Resources for JithuBrowser Setup. No includes: the numeric values below are
// the standard Windows ones (RT_MANIFEST = 24, VOS_NT_WINDOWS32 = 0x40004, VFT_APP = 1).
1 ICON "jithubrowser.ico"
1 24 "setup.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 1
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "JithuBrowser Authors"
      VALUE "FileDescription", "JithuBrowser Setup"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "JithuBrowserSetup"
      VALUE "OriginalFilename", "JithuBrowserSetup.exe"
      VALUE "ProductName", "JithuBrowser"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
